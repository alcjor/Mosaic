{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.invalid/spec/0.1/answers.schema.json",
  "title": "Mosaic kit answers 0.1 (draft)",
  "description": "Shape of every kit tool answer (Specification 0.1, sections 8.1, 8.2 and 8.5). Everything read from the mosaic is inside `data`. Text from the file is length-limited and cut with the marker '…' (labels 120, summaries 400, snippets 600 characters before the marker). Lists stop at `limit` (at most 20 by default) and carry the total count.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/find" },
    { "$ref": "#/$defs/get" },
    { "$ref": "#/$defs/neighbors" },
    { "$ref": "#/$defs/path" },
    { "$ref": "#/$defs/table" },
    { "$ref": "#/$defs/cite" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*:.+$", "maxLength": 512 },
    "typeName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "edgeName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "label": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 121 }] },
    "summary": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 401 }] },
    "snippet": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 601 }] },
    "count": { "type": "integer", "minimum": 0 },
    "envelope": {
      "type": "object",
      "required": ["tool", "mosaic", "data"],
      "properties": {
        "tool": { "type": "string" },
        "mosaic": { "$ref": "#/$defs/hash", "description": "Knowledge hash of the mosaic answered from." },
        "data": { "type": "object" }
      }
    },
    "find": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "tool": { "const": "find" },
        "mosaic": true,
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["results", "total"],
          "properties": {
            "results": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "type", "label", "match"],
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "type": { "$ref": "#/$defs/typeName" },
                  "label": { "$ref": "#/$defs/label" },
                  "match": { "enum": ["exact", "text", "vector"] }
                }
              }
            },
            "total": { "$ref": "#/$defs/count" }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "get": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "tool": { "const": "get" },
        "mosaic": true,
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "label", "summary", "props", "aliases", "external_refs", "links"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "type": { "$ref": "#/$defs/typeName" },
            "label": { "$ref": "#/$defs/label" },
            "summary": { "$ref": "#/$defs/summary" },
            "props": { "oneOf": [{ "type": "null" }, { "type": "object" }] },
            "aliases": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 121 } },
            "aliases_total": { "$ref": "#/$defs/count" },
            "external_refs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["system", "kind", "locator"],
                "properties": {
                  "system": { "type": "string" },
                  "kind": { "type": "string" },
                  "locator": { "type": "object" }
                }
              }
            },
            "external_refs_total": { "$ref": "#/$defs/count" },
            "links": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["edge", "direction", "count"],
                "properties": {
                  "edge": { "$ref": "#/$defs/edgeName" },
                  "direction": { "enum": ["out", "in"] },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "links_total": { "$ref": "#/$defs/count" }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "neighbors": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "tool": { "const": "neighbors" },
        "mosaic": true,
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "edges", "total"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "edges": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["edge", "direction", "id", "label"],
                "properties": {
                  "edge": { "$ref": "#/$defs/edgeName" },
                  "direction": { "enum": ["out", "in"] },
                  "id": { "$ref": "#/$defs/id" },
                  "label": { "$ref": "#/$defs/label" },
                  "qualifier": { "type": "string" }
                }
              }
            },
            "total": { "$ref": "#/$defs/count" }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "path": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "tool": { "const": "path" },
        "mosaic": true,
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "found", "max_hops", "edges"],
          "properties": {
            "from": { "$ref": "#/$defs/id" },
            "to": { "$ref": "#/$defs/id" },
            "found": { "type": "boolean" },
            "max_hops": { "type": "integer", "minimum": 1, "maximum": 4 },
            "edges": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "type", "to"],
                "properties": {
                  "from": { "$ref": "#/$defs/id" },
                  "type": { "$ref": "#/$defs/edgeName" },
                  "to": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "table": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "tool": { "const": "table" },
        "mosaic": true,
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "columns", "rows", "page", "total"],
          "properties": {
            "type": { "$ref": "#/$defs/typeName" },
            "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "rows": { "type": "array", "maxItems": 100, "items": { "type": "array" } },
            "page": { "type": "integer", "minimum": 1 },
            "total": { "$ref": "#/$defs/count" }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "cite": {
      "allOf": [{ "$ref": "#/$defs/envelope" }],
      "properties": {
        "tool": { "const": "cite" },
        "mosaic": true,
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "evidence", "total"],
          "properties": {
            "subject": {
              "oneOf": [
                { "$ref": "#/$defs/id" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["from", "type", "to"],
                  "properties": {
                    "from": { "$ref": "#/$defs/id" },
                    "type": { "$ref": "#/$defs/edgeName" },
                    "to": { "$ref": "#/$defs/id" },
                    "qualifier": { "type": "string", "description": "The qualifier the call gave; without one, the evidence of every edge of the type between the two nodes (decision on #110)." }
                  }
                }
              ]
            },
            "evidence": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "source_hash", "locator", "method", "confidence", "snippet"],
                "properties": {
                  "source": { "type": "string" },
                  "source_hash": { "$ref": "#/$defs/hash" },
                  "locator": { "type": "string" },
                  "method": { "enum": ["extracted", "inferred"] },
                  "confidence": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
                  "snippet": { "$ref": "#/$defs/snippet" },
                  "via": { "type": "array", "items": { "$ref": "#/$defs/hash" } }
                }
              }
            },
            "total": { "$ref": "#/$defs/count" }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "error": {
      "description": "An unknown id returns an error naming the closest matches from find, never an empty success.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "mosaic", "error"],
      "properties": {
        "tool": { "enum": ["find", "get", "neighbors", "path", "table", "cite"] },
        "mosaic": { "$ref": "#/$defs/hash" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "suggestions"],
          "properties": {
            "code": { "enum": ["unknown_id", "unknown_type", "unknown_edge", "unknown_column", "bad_argument", "limit_exceeded"] },
            "message": { "type": "string", "maxLength": 400 },
            "suggestions": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/id" } }
          }
        }
      }
    }
  }
}
