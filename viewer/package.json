{
  "name": "@mosaic/viewer",
  "version": "0.0.0",
  "private": true,
  "description": "The Mosaic viewer: search, tables and node pages over one mosaic, always running the kit in the page.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "build": "vite build",
    "lint": "stylelint \"src/**/*.{css,svelte}\""
  },
  "dependencies": {
    "@mosaic/kit": "0.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "postcss-html": "^2.0.0",
    "stylelint": "~17.16.0",
    "stylelint-config-html": "^2.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
